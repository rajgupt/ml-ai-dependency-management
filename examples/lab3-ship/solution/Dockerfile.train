# Training image: everything churn-train needs, torch included.
#
# Base pinned by digest, not tag -- `python:3.12-slim` moves under you; the
# digest is immutable. Resolved via the registry API (no local pull needed):
#   curl -sS "https://auth.docker.io/token?service=registry.docker.io&scope=repository:library/python:pull" \
#     | jq -r .token > /tmp/t
#   curl -sS -H "Authorization: Bearer $(cat /tmp/t)" \
#     -H "Accept: application/vnd.oci.image.index.v1+json" \
#     https://registry-1.docker.io/v2/library/python/manifests/3.12-slim -D - -o /dev/null \
#     | grep -i docker-content-digest
# (the `docker pull python:3.12-slim && docker inspect --format='{{index .RepoDigests 0}}' python:3.12-slim`
# route in M6 does the same thing if you have a daemon handy.) Re-resolve and
# re-pin the digest on your own upgrade cadence -- it will not track patches
# for you.

FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217 AS deps
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /usr/local/bin/
WORKDIR /app

# Dependency layer, cached separately from source. --no-install-project skips
# churnkit itself -- there's no src/ copied in yet, so there's nothing to
# install -- and --extra gpu is what pulls torch into THIS image only.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --no-dev --extra gpu

# Only this stage re-runs when source changes; the deps layer above is
# untouched as long as pyproject.toml/uv.lock don't change.
FROM deps AS build
COPY src/ src/
RUN uv sync --frozen --no-dev --extra gpu

# Runtime: nothing but the venv and the source -- no uv, no build tools.
FROM python:3.12-slim@sha256:09f7da3bc104798d0afb40bc08d23ab2da20a76130cec1f2ef170848f5d85217 AS train
WORKDIR /app
COPY --from=build /app/.venv .venv
COPY --from=build /app/src src
ENV PATH="/app/.venv/bin:$PATH"
ENTRYPOINT ["churn-train"]
